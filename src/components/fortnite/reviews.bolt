<div class="reviews">
    <div class="review-two">
        <div class="reviewTopic-big">
            <p class="review-topic" data-i18n="gameplay">GAMEPLAY</p>
            <div class="review-topic-div">
                <p id="${code}-gameplay" placeholder="Vazio" class="review-topictext" ${editableAttr} oninput="debouncedSave('${code}')">${data.gameplay || ""}</p>
            </div>
        </div>
        <div class="reviewTopic-smaller">
            <p class="review-topic" data-i18n="loot-pool">LOOT POOL</p>
            <div class="review-topic-div">
                <p id="${code}-loot" placeholder="Vazio" class="review-topictext" ${editableAttr} oninput="debouncedSave('${code}')">${data.loot || ""}</p>
            </div>
        </div>
    </div>
    
    <div class="reviewTopic-mapa">
        <p class="review-topic" data-i18n="map">MAPA</p>
        <div class="review-topic-div">
            <p id="${code}-mapa" placeholder="Vazio" class="review-topictext" ${editableAttr} oninput="debouncedSave('${code}')">${data.mapa || ""}</p>
        </div>
    </div>
        
    <div class="review-two">
        <div class="reviewTopic-big">
            <p class="review-topic" data-i18n="story">HISTÓRIA</p>
            <div class="review-topic-div">
                <p id="${code}-story" placeholder="Vazio" class="review-topictext" ${editableAttr} oninput="debouncedSave('${code}')">${data.story || ""}</p>
            </div>
        </div>
        <div class="reviewTopic-small">
            <p class="review-topic" data-i18n="battle-pass">PASSE DE BATALHA</p>
            <div class="review-topic-div">
                <p id="${code}-passe" placeholder="Vazio" class="review-topictext" ${editableAttr} oninput="debouncedSave('${code}')">${data.passe || ""}</p>
            </div>
        </div>
    </div>
</div>