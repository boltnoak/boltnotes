:root {
    --bg: rgba(250, 250, 250);

    --sep-bar: rgba(210, 210, 210, 0.4);

    --text: rgba(0, 0, 0);
    --text-dark-gray: rgba(7,7,7);
    --text-gray: rgba(50, 50, 50);
    --text-light-gray: rgba(110, 110, 110);
    --text-green: rgba(0, 70, 30);
    --text-blue: rgb(0, 90, 150);
    --text-yellow: rgba(250, 110, 50);
    --text-orange: rgb(160, 70, 0);
    --text-red: rgba(255, 70, 70);

    --green: rgba(0, 150, 70);
    --blue: rgba(20, 150, 255);
    --yellow: rgba(250, 190, 0);
    --orange: rgba(250, 125, 50);
    --red: rgba(255, 70, 70);
    
    --chart-1: rgba(0, 150, 70);
    --chart-2: rgba(20, 150, 255);
    --chart-3: rgb(0, 50, 170);
    --chart-4: rgba(250, 190, 0);
    --chart-5: rgba(250, 130, 50);
    --chart-6: rgba(255, 70, 70);

    --green-light: rgba(0, 200, 90);
    --blue-light: rgba(20, 180, 255);
    --yellow-light: rgba(250, 255, 50);
    --orange-light: rgba(250, 140, 90);
    --red-light: rgba(255, 90, 90);

    --btn: rgba(200,200,200);
    --btn-hover: rgba(227,227,227);
    --btn-color: rgba(20, 150, 255);
    --btn-hover-color: rgba(20, 170, 255);
    --btn-text-color: rgba(0, 75, 127.5);

    --tag: rgba(220,220,220,.75);

    --tab: rgba(220,220,220);
    --tab-hover: rgba(225,225,225);
    --tab-active: rgba(235,235,235);

    --more-video-active: rgba(215,215,215,.7);
    --more-video-hover: rgba(215,215,215,.4);

    --fortnite-season-tags: rgba(235,235,235);
}