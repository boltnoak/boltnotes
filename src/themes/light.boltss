:root {
    --bg: rgba(245, 245, 245);

    --sep-bar: rgba(210, 210, 210, 0.4);

    --text: rgba(0, 0, 0);
    --text-dark-gray: rgba(80,80,80);
    --text-gray: rgba(150, 150, 150);
    --text-light-gray: rgba(210, 210, 210);
    --text-green: rgba(0, 70, 30);
    --text-blue: rgb(0, 90, 150);
    --text-yellow: rgb(190, 130, 0);
    --text-orange: rgb(160, 70, 0);
    --text-red: rgb(155, 35, 35);

    --green: rgba(0, 150, 70);
    --blue: rgba(20, 150, 255);
    --yellow: rgba(250, 190, 0);
    --orange: rgba(250, 130, 50);
    --orange-glow: rgb(255, 175, 80);
    --red: rgba(255, 70, 70);

    --chart-1: rgba(0, 150, 70);
    --chart-2: rgba(20, 150, 255);
    --chart-3: rgb(0, 50, 170);
    --chart-4: rgba(250, 190, 0);
    --chart-5: rgba(250, 130, 50);
    --chart-6: rgba(255, 70, 70);

    --green-light: rgba(0, 200, 90);
    --blue-light: rgba(20, 180, 255);
    --yellow-light: rgb(255, 215, 50);
    --orange-light: rgba(250, 165, 50);
    --red-light: rgba(255, 90, 90);

    --btn-shadow: rgba(30,30,30,.2);
    --btn: rgba(215,215,215);
    --btn-glow: rgba(245, 245, 245);
    --btn-hover: rgba(230,230,230);
    --btn-hover-glow: rgba(255, 255, 255);
    --btn-color: rgb(0, 135, 255);
    --btn-glow-color: rgb(20, 170, 255);
    --btn-hover-color: rgba(20, 170, 255);
    --btn-hover-glow-color: rgba(70, 190, 255);
    --btn-text-color: rgba(0, 75, 120);

    --tag: rgba(220,220,220,.75);

    --tab: rgba(215,215,215);
    --tab-hover: rgba(225,225,225);
    --tab-active: rgba(235,235,235);

    --more-video-active: rgba(215,215,215,.7);
    --more-video-hover: rgba(215,215,215,.4);

    --fortnite-season-tags: rgba(235,235,235);
}